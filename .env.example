# Copy this file to .env and fill in real values.
# .env is already covered by .gitignore ("Environment secrets") - never commit the real one.

# Path to the Firebase service account JSON (also gitignored - share it via
# Drive/WhatsApp/whatever, never via git).
FIREBASE_SERVICE_ACCOUNT_FILE=netramai-firebase-adminsdk.json

# Google Maps (Routes + Geocoding) API key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
